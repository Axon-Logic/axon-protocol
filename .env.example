# Stellar Network
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"
STELLAR_EXPLORER_BASE=https://stellar.expert/explorer/testnet

# Contract addresses (written by `npm run deploy:testnet`)
AGENT_VAULT_CONTRACT_ID=
POLICY_ENGINE_CONTRACT_ID=
REGISTRY_CONTRACT_ID=
# Stellar Asset Contract the vault holds funds in (native XLM on testnet)
NATIVE_TOKEN_CONTRACT_ID=

# Identities in the Stellar CLI key store, plus their public addresses
AXON_OWNER_IDENTITY=axon-owner
AXON_AGENT_IDENTITY=axon-agent
AXON_RECIPIENT_IDENTITY=axon-recipient
AXON_OWNER_ADDRESS=
AXON_AGENT_ADDRESS=
AXON_RECIPIENT_ADDRESS=

# Vault guardrails, in stroops (1 XLM = 10,000,000 stroops)
POLICY_MAX_PER_TX=10000000
POLICY_MAX_PER_PERIOD=50000000
POLICY_PERIOD_LEDGERS=17280

# API
API_PORT=3000
API_SECRET=change_me_in_production

# Agent Runtime
AGENT_RUNTIME_PORT=4000
AGENT_POLL_INTERVAL_MS=5000

# Optional: secret keys for signing scripts, instead of the CLI key store.
# OWNER_SECRET_KEY=
# AGENT_SECRET_KEY=
# Used by contracts/scripts/upgrade-contract.sh only.
ADMIN_SECRET_KEY=
